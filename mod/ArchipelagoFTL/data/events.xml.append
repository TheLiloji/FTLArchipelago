<event name="AP_EVT_ANOTHER_WORLD">
    <preventQuest/>
    <beaconType load="AP_BEACON_SIGNAL"/>
    <loadEventList first="true" default="AP_EVT_ANOTHER_WORLD_PLAIN">
        <event load="AP_EVT_ANOTHER_WORLD_LINK" req="ap_traplink" lvl="1"/>
    </loadEventList>
</event>
<event name="AP_EVT_ANOTHER_WORLD_LINK">
    <preventQuest/>
    <text id="ap_evt_another_world_text"/>
    <img back="AP_BACKGROUND" planet="AP_PLANET"/>
    <beaconType load="AP_BEACON_SIGNAL"/>
    <choice>
        <text id="ap_evt_another_world_c1"/>
        <event name="AP_EVT_ANOTHER_WORLD_A">
            <text id="ap_evt_another_world_c1_text"/>
            <item_modify>
                <item type="fuel" min="2" max="2"/>
            </item_modify>
            <damage amount="1"/>
        </event>
    </choice>
    <choice>
        <text id="ap_evt_another_world_c2"/>
        <event name="AP_EVT_ANOTHER_WORLD_B">
            <text id="ap_evt_another_world_c2_text"/>
            <item_modify>
                <item type="scrap" min="40" max="40"/>
            </item_modify>
        </event>
    </choice>
</event>
<event name="AP_EVT_ANOTHER_WORLD_PLAIN">
    <preventQuest/>
    <text id="ap_evt_another_world_text"/>
    <img back="AP_BACKGROUND" planet="AP_PLANET"/>
    <beaconType load="AP_BEACON_SIGNAL"/>
    <choice>
        <text id="ap_evt_another_world_c1"/>
        <event name="AP_EVT_ANOTHER_WORLD_PLAIN_A">
            <text id="ap_evt_another_world_c1_text"/>
            <item_modify>
                <item type="fuel" min="2" max="2"/>
            </item_modify>
            <damage amount="1"/>
        </event>
    </choice>
    <choice>
        <text id="ap_evt_another_world_void"/>
        <event name="AP_EVT_ANOTHER_WORLD_VOID">
            <text id="ap_evt_another_world_void_text"/>
            <item_modify>
                <item type="scrap" min="40" max="40"/>
            </item_modify>
            <damage amount="2"/>
        </event>
    </choice>
    <choice>
        <text id="ap_evt_another_world_pass"/>
        <event name="AP_EVT_ANOTHER_WORLD_PASS">
            <text id="ap_evt_another_world_pass_text"/>
        </event>
    </choice>
</event>

<ship name="AP_SHIP_HIJACKER" auto_blueprint="SHIPS_PIRATE">
    <surrender chance="0.5" min="3" max="4">
        <text id="ap_evt_hijack_surrender_text"/>
        <choice>
            <text id="ap_evt_hijack_surrender_c1"/>
            <event load="AP_HIJACK_YIELD"/>
        </choice>
        <choice>
            <text id="ap_evt_hijack_surrender_c2"/>
            <event/>
        </choice>
    </surrender>
    <destroyed load="AP_HIJACK_WON"/>
    <deadCrew load="AP_HIJACK_DEADCREW"/>
</ship>

<event name="AP_HIJACK_YIELD">
    <beaconType load="AP_BEACON_SIGNAL"/>
    <text id="ap_evt_hijack_yield_text"/>
    <ship hostile="false"/>
</event>

<event name="AP_HIJACK_WON">
    <beaconType load="AP_BEACON_SIGNAL"/>
    <text id="ap_evt_hijack_destroyed_text"/>
    <autoReward level="MED">standard</autoReward>
</event>

<event name="AP_HIJACK_DEADCREW">
    <beaconType load="AP_BEACON_SIGNAL"/>
    <text id="ap_evt_hijack_deadcrew_text"/>
    <autoReward level="HIGH">standard</autoReward>
</event>

<event name="AP_EVT_HIJACK">
    <preventQuest/>
    <text id="ap_evt_hijack_text"/>
    <img back="AP_BACKGROUND" planet="AP_PLANET"/>
    <beaconType load="AP_BEACON_SIGNAL"/>
    <choice>
        <text id="ap_evt_hijack_c1"/>
        <event name="AP_EVT_HIJACK_A">
            <text id="ap_evt_hijack_c1_text"/>
            <ship load="AP_SHIP_HIJACKER" hostile="true"/>
        </event>
    </choice>
    <choice>
        <text id="ap_evt_hijack_c2"/>
        <event name="AP_EVT_HIJACK_B">
            <text id="ap_evt_hijack_c2_text"/>
            <item_modify>
                <item type="scrap" min="-20" max="-20"/>
            </item_modify>
        </event>
    </choice>
    <choice>
        <text id="ap_evt_hijack_c3"/>
        <event name="AP_EVT_HIJACK_C">
            <text id="ap_evt_hijack_c3_text"/>
        </event>
    </choice>
</event>

<!-- Anti-Ship Battery Trap: loaded by the mod in the middle of a fight, the enemy ship stays. -->
<event name="AP_TRAP_ASB">
    <text id="ap_trap_asb_text"/>
    <environment type="PDS" target="player"/>
</event>

<!-- Power Surge Trap: the enemy of the fight unleashes a Flagship power surge. -->
<event name="AP_TRAP_SURGE_LASER">
    <text id="ap_trap_surge_text"/>
    <superBarrage player="false"/>
</event>

<event name="AP_TRAP_SURGE_DRONES">
    <text id="ap_trap_surge_text"/>
    <superDrones player="false"/>
</event>

<!-- Lighter surges for sectors 1 and 2 (AP_SURGE_LIGHT_* in hyperspace.xml.append). -->
<event name="AP_TRAP_SURGE_LASER_LIGHT">
    <text id="ap_trap_surge_text"/>
    <superBarrage player="false" name="AP_SURGE_LIGHT_LASER"/>
</event>

<event name="AP_TRAP_SURGE_DRONES_LIGHT">
    <text id="ap_trap_surge_text"/>
    <superDrones player="false" name="AP_SURGE_LIGHT_DRONES"/>
</event>

<!-- The trap's anti-ship battery powers down once the fight is over. -->
<event name="AP_TRAP_ASB_END">
    <text id="ap_trap_asb_end_text"/>
    <removeHazards/>
</event>

<!-- Put back the beacon's own hazard after AP_TRAP_ASB_END cleared them all. No text: no box opens. -->
<event name="AP_TRAP_RESTORE_ASTEROID">
    <environment type="asteroid"/>
</event>

<event name="AP_TRAP_RESTORE_SUN">
    <environment type="sun"/>
</event>

<event name="AP_TRAP_RESTORE_PULSAR">
    <environment type="pulsar"/>
</event>

<event name="AP_TRAP_RESTORE_STORM">
    <environment type="storm"/>
</event>
