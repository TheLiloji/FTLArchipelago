
<seeds enabled="true" allowUnlocks="true" allowAchievements="true" allowMetaVars="true"/>

<saveFile>
    <prefix>ap</prefix>
    <inheritMode>2</inheritMode>
</saveFile>

<multipleOverCapacity enabled="true"/>

<augments>
    <aug name="ENERGY_SHIELD"><locked/></aug>
    <aug name="SHIELD_RECHARGE"><locked/></aug>
</augments>

<ships>
    <ship name="PLAYER_SHIP_ANAEROBIC" noAppend="true">
        <unlock variant="a"><type>1</type><value>99</value><silent/></unlock>
        <unlock variant="b"><type>1</type><value>99</value><silent/></unlock>
    </ship>
    <ship name="PLAYER_SHIP_CIRCLE" noAppend="true">
        <unlock variant="a"><type>1</type><value>99</value><silent/></unlock>
        <unlock variant="b"><type>1</type><value>99</value><silent/></unlock>
