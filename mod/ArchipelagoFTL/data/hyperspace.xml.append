        <unlock variant="a"><type>1</type><value>99</value><silent/></unlock>
        <unlock variant="b"><type>1</type><value>99</value><silent/></unlock>
        <unlock variant="c"><type>1</type><value>99</value><silent/></unlock>
    </ship>
    <ship name="PLAYER_SHIP_JELLY" noAppend="true">
        <unlock variant="a"><type>1</type><value>99</value><silent/></unlock>
        <unlock variant="b"><type>1</type><value>99</value><silent/></unlock>
        <unlock variant="c"><type>1</type><value>99</value><silent/></unlock>
    </ship>
    <ship name="PLAYER_SHIP_MANTIS" noAppend="true">
        <unlock variant="a"><type>1</type><value>99</value><silent/></unlock>
        <unlock variant="b"><type>1</type><value>99</value><silent/></unlock>
        <unlock variant="c"><type>1</type><value>99</value><silent/></unlock>
    </ship>
    <ship name="PLAYER_SHIP_ROCK" noAppend="true">
        <unlock variant="a"><type>1</type><value>99</value><silent/></unlock>
        <unlock variant="b"><type>1</type><value>99</value><silent/></unlock>
        <unlock variant="c"><type>1</type><value>99</value><silent/></unlock>
    </ship>
    <ship name="PLAYER_SHIP_STEALTH" noAppend="true">
        <unlock variant="a"><type>1</type><value>99</value><silent/></unlock>
        <unlock variant="b"><type>1</type><value>99</value><silent/></unlock>
        <unlock variant="c"><type>1</type><value>99</value><silent/></unlock>
    </ship>
</ships>

<events>
    <beaconType name="AP_BEACON" id="ap_beacon_label" global="true" persist="false"
                hideVanillaLabel="false">
        <color r="150" g="140" b="220" a="1.0"/>
        <undiscoveredTooltip id="ap_beacon_undiscovered"/>
        <unvisitedTooltip id="ap_beacon_unvisited"/>
        <visitedTooltip id="ap_beacon_visited"/>
    </beaconType>

    <beaconType name="AP_BEACON_SIGNAL" id="ap_beacon_label" global="true" persist="false"
                hideVanillaLabel="false">
        <color r="150" g="140" b="220" a="1.0"/>
        <undiscoveredTooltip id="ap_signal_undiscovered"/>
        <unvisitedTooltip id="ap_signal_unvisited"/>
        <visitedTooltip id="ap_signal_visited"/>
    </beaconType>

    <event name="AP_EVT_PACKAGE">
        <changeBackground>AP_BACKGROUND</changeBackground>
    </event>
    <event name="AP_EVT_ZOLTAN_TITHE">
        <changeBackground>AP_BACKGROUND</changeBackground>
    </event>
    <event name="AP_EVT_SLUG_WHISPER">
        <changeBackground>AP_BACKGROUND</changeBackground>
    </event>
    <event name="AP_EVT_ANOTHER_WORLD">
        <changeBackground>AP_BACKGROUND</changeBackground>
    </event>
    <event name="AP_EVT_ZOLTAN_TITHE_LINK">
        <changeBackground>AP_BACKGROUND</changeBackground>
    </event>
    <event name="AP_EVT_ZOLTAN_TOLL">
        <changeBackground>AP_BACKGROUND</changeBackground>
    </event>
    <event name="AP_EVT_ANOTHER_WORLD_LINK">
        <changeBackground>AP_BACKGROUND</changeBackground>
    </event>
    <event name="AP_EVT_ANOTHER_WORLD_PLAIN">
        <changeBackground>AP_BACKGROUND</changeBackground>
    </event>
</events>

<store>
    <customStore id="AP_STORE">
        <category type="WEAPONS">
            <customTitle>ARCHIPELAGO</customTitle>
            <chance>100</chance>
            <allowDuplicates/>
            <item><blueprint>AP_GIFT_1</blueprint></item>
            <item><blueprint>AP_GIFT_2</blueprint></item>
            <item><blueprint>AP_GIFT_3</blueprint></item>
        </category>

        <category type="AUGMENTS">
            <chance>100</chance>
            <allowDuplicates/>
            <item><blueprint>AP_DEAL_1</blueprint></item>
            <item><blueprint>AP_DEAL_2</blueprint></item>
            <item><blueprint>AP_DEAL_3</blueprint></item>
        </category>

        <resource>
            <type>fuel</type>
            <count min="3" max="9"/>
            <price>3</price>
        </resource>
        <resource>
            <type>missiles</type>
            <count min="4" max="12"/>
            <price>4</price>
        </resource>
        <resource>
            <type>drones</type>
            <count min="2" max="6"/>
            <price>6</price>
        </resource>

        <hullRepair>
            <price min="2" max="5"/>
            <sectorScaled/>
        </hullRepair>
    </customStore>

